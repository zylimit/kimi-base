{
  "version": 1,
  "layers": ["domain", "app", "infra"],
  "globalPaths": [
    "docs/**",
    "*.md",
    ".kimi-base/**",
    ".kimi-code/**",
    ".github/**"
  ],
  "ignored": [],
  "review": {
    "profile": "team",
    "maxRounds": 3,
    "requireStructured": true
  },
  "modules": [
    {
      "name": "example-app",
      "paths": ["src/app/**"],
      "layer": "app",
      "dependsOn": ["example-domain"],
      "forbiddenDependencies": [],
      "provides": [],
      "attributes": {
        "resilience": "medium",
        "security": "high",
        "safety": "low",
        "privacy": "medium",
        "reliability": "high"
      }
    },
    {
      "name": "example-domain",
      "paths": ["src/domain/**"],
      "layer": "domain",
      "dependsOn": [],
      "forbiddenDependencies": ["example-infra"],
      "provides": [],
      "attributes": {
        "resilience": "high",
        "security": "high",
        "safety": "medium",
        "privacy": "high",
        "reliability": "critical"
      }
    },
    {
      "name": "example-infra",
      "paths": ["src/infra/**"],
      "layer": "infra",
      "dependsOn": ["example-domain"],
      "forbiddenDependencies": [],
      "provides": [],
      "attributes": {
        "resilience": "high",
        "security": "critical",
        "safety": "high",
        "privacy": "high",
        "reliability": "high"
      }
    }
  ]
}
