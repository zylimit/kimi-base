{
  "version": 1,
  "checks": [
    {
      "id": "catalog-lint",
      "kind": "static",
      "tier": "inner",
      "command": "node .kimi-base/runtime/kimi-base.mjs catalog lint",
      "attributes": [
        "reliability"
      ],
      "allowFastSkip": false,
      "timeoutSec": 120
    },
    {
      "id": "arch-check",
      "kind": "static",
      "tier": "middle",
      "command": "node .kimi-base/runtime/kimi-base.mjs arch check",
      "attributes": [
        "reliability"
      ],
      "allowFastSkip": false,
      "timeoutSec": 300
    },
    {
      "id": "adr-check",
      "kind": "static",
      "tier": "middle",
      "command": "node .kimi-base/runtime/kimi-base.mjs adr check",
      "attributes": [
        "reliability"
      ],
      "allowFastSkip": true,
      "timeoutSec": 60
    },
    {
      "id": "fitness",
      "kind": "static",
      "tier": "inner",
      "command": "node .kimi-base/runtime/kimi-base.mjs fitness",
      "attributes": [
        "security",
        "privacy",
        "reliability",
        "resilience",
        "safety"
      ],
      "allowFastSkip": false,
      "timeoutSec": 300
    },
    {
      "id": "attributes",
      "kind": "static",
      "tier": "middle",
      "command": "node .kimi-base/runtime/kimi-base.mjs quality status",
      "attributes": [
        "security",
        "safety",
        "privacy",
        "resilience",
        "reliability"
      ],
      "allowFastSkip": false,
      "timeoutSec": 60
    },
    {
      "id": "unit",
      "kind": "unit",
      "tier": "middle",
      "command": "",
      "attributes": [
        "reliability"
      ],
      "allowFastSkip": true,
      "timeoutSec": 600,
      "note": "按项目技术栈填写，如 npm test / pytest -q；留空=BLOCKED（绝不假绿）"
    },
    {
      "id": "static",
      "kind": "static",
      "tier": "inner",
      "command": "",
      "attributes": [
        "reliability"
      ],
      "allowFastSkip": true,
      "timeoutSec": 600,
      "note": "类型/静态检查，如 tsc --noEmit / ruff check；留空=BLOCKED"
    },
    {
      "id": "security-scan",
      "kind": "security",
      "tier": "middle",
      "command": "",
      "attributes": [
        "security"
      ],
      "allowFastSkip": false,
      "timeoutSec": 900,
      "note": "如 semgrep/gitleaks（见 adapters.json）；security kind 永不 fast-skip"
    }
  ]
}
