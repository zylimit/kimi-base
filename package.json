{
  "name": "kimi-base",
  "version": "2.0.0",
  "description": "面向 Kimi Code CLI 的 AI 编程 harness 开发脚手架：需求质量、架构看护、五性治理",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node .kimi-base/audit/run-tests.mjs",
    "selftest": "node .kimi-base/runtime/kimi-base.mjs selftest",
    "doctor": "node .kimi-base/runtime/kimi-base.mjs doctor .",
    "manifest": "node .kimi-base/runtime/kimi-base.mjs manifest --write",
    "manifest:check": "node .kimi-base/runtime/kimi-base.mjs manifest --check",
    "pack:check": "node .kimi-base/runtime/kimi-base.mjs pack-check"
  },
  "files": [
    "kimi.plugin.json",
    "plugin/",
    ".kimi-base/runtime/",
    ".kimi-base/rules/",
    ".kimi-base/templates/",
    ".kimi-base/audit/",
    ".kimi-base/githooks/",
    ".kimi-base/adapters.json",
    ".kimi-base/state.README",
    ".kimi-base/harness.example.json",
    ".kimi-base/module-catalog.example.json",
    ".kimi-base/verification-matrix.example.json",
    ".kimi-code/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "Product-Spec.md",
    "Product-Spec-CHANGELOG.md",
    "DEV-PLAN.md",
    "setup.sh",
    "setup.ps1",
    "make-release.sh"
  ]
}
